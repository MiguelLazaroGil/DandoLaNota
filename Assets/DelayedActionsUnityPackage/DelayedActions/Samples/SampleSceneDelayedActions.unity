  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 300
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 3
    m_MaxSize: 300
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "<b>How about Coroutine's WaitForSeconds??</b>\nDA allows for the construction
    of <i>Sequences</i>\nCreate a sequence, specify the <b>executor</b> and append
    any number (in any order) of the following comands:\n\t-<b>Wait</b>(seconds)
    : waits for said seconds accumulatively. \n\t-<b>Do</b>(action) : you can specify
    a name here. <i>do</i> s without a <i>wait</i> in between execute on the same
    frame.\n\t-<b>Loop</b>(nTimes) : repeats the currrent section.\n\t-<b>Section</b>()
    : creates a section to be looped. \n\nThen launch it with (you can specify and
    id here or recieve the list of the created ones):\n\t-<b>Start</b> : plays the
    sequence\n\t-<b>LoopInfinite</b> : repeats the sequence to infinity\n\nNote:
    There is an implicit section at the beggining. Also you can add a delay between
    iterations when using <i>Loop</i> and <i>LoopInfinite</i>"
